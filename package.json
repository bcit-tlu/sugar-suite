{
  "name": "sugar-suite",
  "private": true,
  "version": "1.3.8",
  "type": "module",
  "packageManager": "npm@11.21.3",
  "scripts": {
    "build": "vite build",
    "quick": "vite build && vite preview --port 9000",
    "preview": "concurrently \"vite build --watch\" \"vite preview --port 9000\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/browser-instrumentation": "^0.12.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "sass": "^1.108.2",
    "postcss": "^8.5.33",
    "autoprefixer": "^10.7.0",
    "cssnano": "^9.9.0",
    "esbuild": "^0.28.2",
    "terser": "^5.51.3",
    "vite-plugin-compression2": "^2.5.4",
    "glob": "^13.0.7",
    "concurrently": "^10.0.7",
    "jquery": "^4.1.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1"
