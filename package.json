{
  "name": "sugar-suite",
  "private": true,
  "version": "1.3.7",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "vite build",
    "quick": "vite build && vite preview --port 9000",
    "preview": "concurrently \"vite build --watch\" \"vite preview --port 9000\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
