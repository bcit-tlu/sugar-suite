    "@opentelemetry/semantic-conventions": "^1.41.1"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "sass": "^1.100.0",
    "postcss": "^8.5.15",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.1",
    "terser": "^5.48.0",
    "esbuild": "^0.28.0",
    "vite-plugin-compression2": "^2.5.3",
    "glob": "^13.0.6",
    "concurrently": "^9.2.1",
